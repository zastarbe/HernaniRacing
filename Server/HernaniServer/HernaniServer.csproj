<Project Sdk="Microsoft.NET.Sdk">
  <!-- Servidor dedicado de Hernani Racing (Ubuntu / Linux, también funciona en Windows y macOS). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>hernani-server</AssemblyName>
    <RootNamespace>HernaniRacing.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <NoWarn>CS1591;CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- El protocolo es el mismo fichero que usa el juego -->
    <Compile Include="../../Assets/HernaniRacing/Scripts/Net/Shared/NetProtocol.cs" Link="Shared/NetProtocol.cs" />
    <Compile Include="../../Assets/HernaniRacing/Plugins/LiteNetLib/**/*.cs" Link="LiteNetLib/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
